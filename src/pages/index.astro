---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import MailchimpForm from '../components/MailchimpForm.astro';
import site from '../data/site.json';
import { formatPostDate } from '../lib/dates';

const now = new Date();
const upcoming = (await getCollection('events', ({ data }) => (data.end ?? data.start) >= now))
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
  .slice(0, 3);
const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const candidates = await getCollection('candidates', ({ data }) => data.active);
---
<Base title={site.name} description={site.description}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Jackson Hole, Wyoming</p>
      <h1>Working together for the well‑being of Teton County</h1>
      <p class="lede">{site.description}</p>
      <div class="actions">
        <a class="button electric" href="/sign-up">Join our e‑mail list</a>
        <a class="button ghost" href="/local-action">Get involved</a>
        <a class="button red" href={site.donateUrl} rel="noopener">Donate</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Upcoming events</h2>
        <a href="/events">All events →</a>
      </div>
      {upcoming.length ? (
        <div class="grid">{upcoming.map((event) => <EventCard event={event} />)}</div>
      ) : (
        <p class="muted">No events on the calendar right now. Join the e‑mail list and we'll let you know what's next.</p>
      )}
    </div>
  </section>

  {candidates.length > 0 && (
    <section class="section pale">
      <div class="wrap">
        <div class="section-head">
          <h2>2026 Democratic candidates</h2>
          <a href="/candidates">Meet the candidates →</a>
        </div>
        <p class="lede-sm">General election is <strong>Tuesday, November 3, 2026</strong>. Early and absentee voting begins October 6. You can register and vote the same day in Teton County. <a href="/how-to-vote">How to vote →</a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap three">
      <div>
        <h2>Get involved</h2>
        <p>Small steps add up. Vote in every election, talk to your neighbors, show up to public meetings, or run to be a Precinct Committee Officer for your neighborhood.</p>
        <p><a href="/local-action">Local action</a> · <a href="/state-action">State action</a> · <a href="/national-action">National action</a> · <a href="/apply-for-pco">Become a PCO</a></p>
      </div>
      <div>
        <h2>Latest news</h2>
        <ul class="news-list">
          {posts.map((p) => (
            <li><a href={`/news/${p.id}`}>{p.data.title}</a><br /><span class="muted small">{formatPostDate(p.data.date)}</span></li>
          ))}
        </ul>
        <p><a href="/news">All news →</a></p>
      </div>
      <div>
        <MailchimpForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--dark-navy); color: var(--white); padding: clamp(48px, 8vw, 96px) 0; border-bottom: 6px solid var(--electric); }
  .hero .eyebrow { color: var(--electric); }
  .hero h1 { color: var(--white); max-width: 18ch; margin-top: 8px; }
  .hero .lede { max-width: 58ch; font-size: 1.15rem; color: #d6e0e6; margin: 20px 0 28px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero .button.ghost { color: var(--white); border-color: var(--white); }
  .hero .button.ghost:hover { background: var(--white); color: var(--dark-navy); }
  .lede-sm { max-width: var(--measure); font-size: 1.1rem; margin: 0; }
  .three { display: grid; gap: 40px; grid-template-columns: 1fr 1fr 1.1fr; align-items: start; }
  .three h2 { font-size: 1.6rem; margin-bottom: 10px; }
  .news-list { list-style: none; padding: 0; margin: 0; }
  .news-list li { padding: 8px 0; border-bottom: 1px solid var(--light-grey); }
  .news-list a { font-family: var(--font-slab); font-weight: 600; text-decoration: none; color: var(--dark-navy); }
  .news-list a:hover { color: var(--electric-ink); }
  .small { font-size: 0.85rem; }
  @media (max-width: 860px) { .three { grid-template-columns: 1fr; } }
</style>
