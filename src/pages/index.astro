---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import MailchimpForm from '../components/MailchimpForm.astro';
import site from '../data/site.json';
import { formatPostDate } from '../lib/dates';

const now = new Date();
// Recurring events (same title) show only their next occurrence here.
const seen = new Set<string>();
const upcoming = (await getCollection('events', ({ data }) => (data.end ?? data.start) >= now))
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
  .filter((e) => { const k = e.data.title.trim().toLowerCase(); if (seen.has(k)) return false; seen.add(k); return true; })
  .slice(0, 3);
const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const candidates = (await getCollection('candidates', ({ data }) => data.active)).sort((a, b) => a.data.order - b.data.order);
const withPhotos = candidates.filter((c) => c.data.photo).slice(0, 6);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');

const ways = [
  { title: 'Local', text: 'Vote in town and county races, show up to public meetings, become a Precinct Committee Officer.', href: '/local-action' },
  { title: 'State', text: 'Track the Legislature, contact your legislators, testify, and back Democrats around Wyoming.', href: '/state-action' },
  { title: 'National', text: 'Stay informed on federal bills, call Congress, and join the movements that match your values.', href: '/national-action' },
];
---
<Base title={site.name} description={site.description}>
  <section class="hero">
    <img class="photo" src="/images/site/parade-2022.jpg" alt="" width="1200" height="800" fetchpriority="high" />
    <div class="wrap content">
      <p class="eyebrow">Teton County Democratic Party · Jackson Hole, Wyoming</p>
      <h1>Working together for the well‑being of Teton County</h1>
      <p class="lede">Through education, advocacy, and elections. Everyone is welcome.</p>
      <div class="actions">
        <a class="button electric" href="/sign-up">Join our e‑mail list</a>
        <a class="button ghost" href="/local-action">Get involved</a>
        <a class="button red" href={site.donateUrl} rel="noopener">Donate</a>
      </div>
    </div>
    <p class="credit">Fourth of July parade, Jackson, 2022</p>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Upcoming events</h2>
        <a href="/events">All events →</a>
      </div>
      {upcoming.length ? (
        <div class:list={['grid', { single: upcoming.length === 1 }]}>{upcoming.map((event) => <EventCard event={event} />)}</div>
      ) : (
        <p class="muted">No events on the calendar right now. Join the e‑mail list and we'll let you know what's next.</p>
      )}
    </div>
  </section>

  {candidates.length > 0 && (
    <section class="section navy">
      <div class="wrap ballot">
        <div class="ballot-text">
          <p class="eyebrow">General election · Tuesday, November 3, 2026</p>
          <h2>Democrats on your ballot</h2>
          <p>Early and absentee voting begins October 6. In Teton County you can register and vote the same day, all the way through Election Day.</p>
          <p class="actions"><a class="button electric" href="/candidates">Meet the candidates</a><a class="button ghost" href="/how-to-vote">How to vote</a></p>
        </div>
        <ul class="faces" aria-label="Some of the candidates">
          {withPhotos.map(({ data: c }) => (
            <li><a href="/candidates" title={`${c.name}, ${c.office}`}><img src={c.photo} alt={c.name} loading="lazy" /></a></li>
          ))}
          {candidates.filter((c) => !c.data.photo).slice(0, Math.max(0, 6 - withPhotos.length)).map(({ data: c }) => (
            <li><a href="/candidates" title={`${c.name}, ${c.office}`}><span class="initials" aria-hidden="true">{initials(c.name)}</span><span class="sr-only">{c.name}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Get involved</h2>
        <a href="/apply-for-pco">Become a precinct officer →</a>
      </div>
      <div class="ways">
        {ways.map((w) => (
          <a class="way" href={w.href}>
            <span class="tag">{w.title}</span>
            <span class="text">{w.text}</span>
            <span class="more">{w.title} action →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section pale">
    <div class="wrap two">
      <div>
        <div class="section-head">
          <h2>Latest news</h2>
          <a href="/news">All news →</a>
        </div>
        <ul class="news-list">
          {posts.map((p) => (
            <li><a href={`/news/${p.id}`}>{p.data.title}</a><span class="muted small">{formatPostDate(p.data.date)}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <MailchimpForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; background: var(--dark-navy); color: var(--white); min-height: 520px; display: grid; align-items: end; border-bottom: 6px solid var(--electric); overflow: hidden; }
  .hero .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; z-index: -2; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(21, 35, 41, 0.15) 0%, rgba(21, 35, 41, 0.55) 45%, rgba(21, 35, 41, 0.92) 100%); }
  .hero .content { padding: 140px 0 44px; }
  .hero .eyebrow { color: var(--electric); }
  .hero h1 { color: var(--white); max-width: 16ch; margin-top: 10px; font-size: clamp(2.6rem, 6.5vw, 4.4rem); text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25); }
  .hero .lede { max-width: 48ch; font-size: 1.2rem; color: #e3ebf0; margin: 16px 0 26px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; }
  .hero .button.ghost, .navy .button.ghost { color: var(--white); border-color: var(--white); }
  .hero .button.ghost:hover, .navy .button.ghost:hover { background: var(--white); color: var(--dark-navy); }
  .credit { position: absolute; right: 12px; bottom: 8px; margin: 0; font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }

  .navy { background: var(--navy); color: #dbe6ef; position: relative; overflow: hidden; }
  .navy::after { content: ""; position: absolute; right: -40px; bottom: -30px; width: 360px; height: 290px; background: url('/images/brand/mark.svg') no-repeat / contain; opacity: 0.08; pointer-events: none; }
  .navy h2, .navy .eyebrow { color: var(--white); }
  .navy .eyebrow { color: var(--electric); }
  .ballot { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; position: relative; z-index: 1; }
  .ballot-text p { max-width: 52ch; }
  .ballot-text .actions { margin-top: 20px; }
  .faces { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .faces li a { display: block; aspect-ratio: 1; border-radius: 6px; overflow: hidden; background: rgba(255, 255, 255, 0.08); border: 2px solid rgba(255, 255, 255, 0.12); }
  .faces li a:hover { border-color: var(--electric); }
  .faces img { width: 100%; height: 100%; object-fit: cover; }
  .faces .initials { display: grid; place-items: center; height: 100%; font-family: var(--font-display); font-weight: 800; font-size: 2rem; color: var(--electric); }

  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .way { display: flex; flex-direction: column; gap: 10px; padding: 24px; background: var(--white); border: 1px solid var(--light-grey); border-top: 4px solid var(--electric); border-radius: 4px; text-decoration: none; color: var(--dark-grey); }
  .way:hover { border-top-color: var(--navy); box-shadow: 0 8px 24px rgba(21, 35, 41, 0.08); }
  .way .tag { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; text-transform: uppercase; color: var(--dark-navy); line-height: 1; }
  .way .text { line-height: 1.5; }
  .way .more { margin-top: auto; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.9rem; color: var(--electric-ink); }

  .two { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: start; }
  .news-list { list-style: none; padding: 0; margin: 0; }
  .news-list li { padding: 12px 0; border-bottom: 1px solid var(--light-grey); display: grid; gap: 2px; }
  .news-list a { font-family: var(--font-slab); font-weight: 600; font-size: 1.1rem; text-decoration: none; color: var(--dark-navy); }
  .news-list a:hover { color: var(--electric-ink); }
  .small { font-size: 0.85rem; }

  @media (max-width: 860px) {
    .hero .content { padding-top: 120px; }
    .ballot, .two { grid-template-columns: 1fr; gap: 28px; }
    .ways { grid-template-columns: 1fr; }
    .faces { grid-template-columns: repeat(6, 1fr); gap: 8px; }
    .faces .initials { font-size: 1.2rem; }
  }
</style>
