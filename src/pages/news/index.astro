---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPostDate } from '../../lib/dates';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const byYear = new Map<number, typeof posts>();
for (const p of posts) { const y = p.data.date.getFullYear(); byYear.set(y, [...(byYear.get(y) ?? []), p]); }
---
<Base title="News" description="Announcements and updates from the Teton County Democratic Party.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Teton Dems</p>
      <h1>News &amp; announcements</h1>
    </header>
    {[...byYear.entries()].map(([year, list]) => (
      <section class="year">
        <h2>{year}</h2>
        <ul>
          {list.map((p) => (
            <li>
              <span class="when">{formatPostDate(p.data.date)}</span>
              <a href={`/news/${p.id}`}>{p.data.title}</a>
              {p.data.categories.length > 0 && <span class="cat">{p.data.categories.join(', ')}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .year { margin-bottom: 40px; }
  .year h2 { font-size: 1.4rem; color: var(--electric-ink); margin-bottom: 8px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 15ch minmax(0, 1fr) auto; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--pale); align-items: baseline; }
  .when { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--cool-grey); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  li a { font-family: var(--font-slab); font-weight: 600; color: var(--dark-navy); text-decoration: none; }
  li a:hover { color: var(--electric-ink); }
  .cat { font-size: 0.8rem; color: var(--cool-grey); }
  @media (max-width: 600px) { li { grid-template-columns: 1fr; gap: 2px; } }
</style>
