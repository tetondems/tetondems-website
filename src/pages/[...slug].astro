---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import MailchimpForm from '../components/MailchimpForm.astro';
import { formatPostDate } from '../lib/dates';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.archived);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
const { title, description, section, embeds, updated, hero } = page.data;
---
<Base title={title} description={description} image={hero}>
  {hero && (
    <header class="banner">
      <img src={hero} alt="" width="1800" height="983" fetchpriority="high" />
      <div class="wrap text">
        {section && <p class="eyebrow">{section}</p>}
        <h1>{title}</h1>
        {description && description !== title && <p class="lede">{description}</p>}
      </div>
    </header>
  )}
  <div class="wrap">
    {!hero && (
      <header class="page-head">
        {section && <p class="eyebrow">{section}</p>}
        <h1>{title}</h1>
        {description && description !== title && <p class="lede">{description}</p>}
      </header>
    )}
    <div class="layout">
      <article class="prose">
        <Content />
        {embeds.includes('mailchimp') && <div class="embed"><MailchimpForm /></div>}
      </article>
      <aside>
        <slot name="aside" />
      </aside>
    </div>
    {updated && <p class="muted updated">Last updated {formatPostDate(updated)}</p>}
  </div>
</Base>

<style>
  .banner { position: relative; isolation: isolate; background: var(--dark-navy); color: var(--white); min-height: 320px; display: grid; align-items: end; border-bottom: 6px solid var(--electric); margin-bottom: 40px; overflow: hidden; }
  .banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; z-index: -2; }
  .banner::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(21, 35, 41, 0.1) 0%, rgba(21, 35, 41, 0.5) 50%, rgba(21, 35, 41, 0.9) 100%); }
  .banner .text { padding: 96px 0 28px; }
  .banner .eyebrow { color: var(--electric); }
  .banner h1 { color: var(--white); text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3); }
  .banner .lede { color: #e3ebf0; font-size: 1.15rem; max-width: var(--measure); margin: 10px 0 0; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; }
  .embed { margin-top: 2.5em; }
  .updated { font-size: 0.85rem; margin-top: 48px; }
</style>
