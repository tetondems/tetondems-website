---
import site from '../data/site.json';
interface Props { heading?: string; compact?: boolean }
const { heading = 'Join our e‑mail list', compact = false } = Astro.props;
const { action, honeypot, archive } = site.mailchimp;
---
<form class:list={['mc', { compact }]} action={action} method="post" target="_blank" novalidate>
  <h3>{heading}</h3>
  <p class="muted">We send emails infrequently, about things that matter. <a href={archive} rel="noopener">See past emails.</a></p>
  <div class="fields">
    <label>Email address <span aria-hidden="true">*</span><input type="email" name="EMAIL" required autocomplete="email" /></label>
    <label>First name<input type="text" name="FNAME" autocomplete="given-name" /></label>
    <label>Last name<input type="text" name="LNAME" autocomplete="family-name" /></label>
  </div>
  <div aria-hidden="true" style="position:absolute;left:-5000px"><input type="text" name={honeypot} tabindex="-1" value="" /></div>
  <button class="button electric" type="submit">Subscribe</button>
</form>

<style>
  .mc { background: var(--pale); border-top: 4px solid var(--electric); padding: 24px; border-radius: 4px; max-width: 560px; }
  .mc h3 { margin-bottom: 4px; }
  .mc p { margin: 0 0 16px; font-size: 0.95rem; }
  .fields { display: grid; gap: 12px; margin-bottom: 16px; }
  label { display: grid; gap: 4px; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; }
  input { font: inherit; font-family: var(--font-body); font-size: 1rem; padding: 10px 12px; border: 1px solid var(--light-grey); border-radius: 3px; background: var(--white); }
  input:focus { border-color: var(--electric); }
  .compact .fields { grid-template-columns: 1fr 1fr; }
  .compact .fields label:first-child { grid-column: 1 / -1; }
</style>
